# Copie para .env e ajuste os valores. Nunca versione o arquivo .env.
POSTGRES_DB=gestao_bar
POSTGRES_USER=gestao_bar
POSTGRES_PASSWORD=troque-esta-senha

# Usuário administrativo fixo (criado/atualizado na inicialização do backend)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=troque-esta-senha-forte

# Segredo do JWT: no mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRATION=PT12H

# Origens permitidas para CORS (apps Flutter em desenvolvimento)
CORS_ALLOWED_ORIGINS=http://localhost:*

# Documentação Swagger em /swagger-ui.html. Mantenha false em servidores de produção.
SWAGGER_ENABLED=false
